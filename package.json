{
  "name": "dev-time",
  "displayName": "DevTime - 项目时间统计",
  "description": "统计开发者在项目上花费的时间，集中加密存储，支持多项目汇总、跨电脑同步、图表展示",
  "version": "0.3.0",
  "publisher": "nocmt",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocmt/devtime"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "contributes": {
    "commands": [
      {
        "command": "devtime.showOverview",
        "title": "DevTime: 打开概览"
      },
      {
        "command": "devtime.setPassword",
        "title": "DevTime: 设置密码"
      },
      {
        "command": "devtime.resetPassword",
        "title": "DevTime: 修改密码"
      },
      {
        "command": "devtime.startTracking",
        "title": "DevTime: 开始计时"
      },
      {
        "command": "devtime.stopTracking",
        "title": "DevTime: 停止计时"
      }
    ],
    "configuration": {
      "title": "DevTime",
      "properties": {
        "devtime.hourlyRate": {
          "type": "number",
          "default": 100,
          "description": "%config.hourlyRate%"
        },
        "devtime.idleTimeout": {
          "type": "number",
          "default": 300,
          "description": "%config.idleTimeout%"
        },
        "devtime.currency": {
          "type": "string",
          "default": "¥",
          "description": "%config.currency%"
        },
        "devtime.locale": {
          "type": "string",
          "default": "zh-CN",
          "enum": [
            "zh-CN",
            "en"
          ],
          "description": "%config.locale%"
        },
        "devtime.storagePath": {
          "type": "string",
          "default": "",
          "description": "%config.storagePath%"
        },
        "devtime.ignoredProjects": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "%config.ignoredProjects%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  }
}